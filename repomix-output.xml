        break;
    case TV_TUNER_12V:
        tv_tuner_12v_power_state = power_state;
        break;
    case CAB:
        break;
    case APPLE_AUTH_IC:
        break;
    case HEART_RATE:
        hr_rate_power_state = power_state;
        break;
    case GYMKIT:
        gymkit_power_state = power_state;
        break;
    case USB_5V:
        usb_5v_power_state = power_state;
        break;
