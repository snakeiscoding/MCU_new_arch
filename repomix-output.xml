    } ep;

    __IO uint8_t         supp_ping;                                             /*!< host pipe support PING */
    __IO uint8_t         do_ping;                                               /*!< host pipe do PING  */
    __IO uint32_t        DPID;                                                  /*!< data PID */

    uint8_t              *xfer_buf;                                             /*!< USB transfer buffer */
