FlagStatus syscfg_flag_get(syscfg_flag_enum flag)
{
    /* get flag and interrupt enable state */
    if(RESET != (SYSCFG_STAT & (uint32_t)flag)) {
        return SET;
    } else {
        return RESET;
    }
}

/*!
