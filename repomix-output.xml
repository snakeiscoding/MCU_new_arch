can_receive_message_struct can_receive_message;
can_trasnmit_message_struct can_transmit_message;
#define DEV_CAN1_SFID   ((uint32_t)0x07AA)
#define DEV_CAN1_EFID   ((uint32_t)0xCCDD)
// #define CAN_LOOPBACK_DEBUG
