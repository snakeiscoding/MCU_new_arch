    if(len != 2) {
        mid_soc_cmd_send(CMD_CONTROL_POWER, CMD_RESULT_CODE_INVALID_PARAMETERS, NULL, 0);
        return;
    }
    switch((SOC_CMD_CONTROL_POWER_ID)target) {
    case RS485:
