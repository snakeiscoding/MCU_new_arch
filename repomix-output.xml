    }
    switch((SOC_CMD_CONTROL_POWER_ID)target) {
    case RS485:
        break;
    case CSAFE:
        csafe_power_state = power_state;
        break;
    case HDMI:
        break;
    case AUDIO_SA:
        break;
    case VOICE:
        break;
    case RFID:
