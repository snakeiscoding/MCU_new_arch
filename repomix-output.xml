#include <stdbool.h>
#include <stddef.h>
#include <string.h>
#include "app_soc_cmd_update_func.h"
#include "app_soc_cmd.h"
#include "hal_fw_update_cmd_interface.h"
#include "mid_log.h"
#include "mid_soc_cmd.h"

#define NORMAL_MODE ((uint8_t)0x00)
#define UPDATE_MODE ((uint8_t)0x01)

uint8_t operation_mode = NORMAL_MODE;
void app_soc_cmd_update_set_operation_mode(int mode)
{
    operation_mode = mode;
}

uint8_t app_soc_cmd_update_get_operation_mode(void)
{
    return operation_mode;
}

__attribute__((weak)) uint32_t hal_get_fw_update_parameter(SOC_CMD_UPDATE_PARAMETER_ID id) {return 0;}
void app_soc_cmd_update_parameter_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    uint16_t data_len = 21;
    uint8_t data[21];
    uint32_t *p32 = (uint32_t *)data;
    *(p32++) = hal_get_fw_update_parameter(AP_START_ADDRESS);
    *(p32++) = hal_get_fw_update_parameter(AP_END_ADDRESS);
    *(p32++) = hal_get_fw_update_parameter(PAGE_SIZE);
    data[12] = (uint8_t)hal_get_fw_update_parameter(MAX_PAGES_PER_PACKET);
    uint32_t *p32_next = (uint32_t *)&data[13];
    *(p32_next++) = hal_get_fw_update_parameter(NVRAM_START_ADDRESS);
    *(p32_next)   = hal_get_fw_update_parameter(NVRAM_END_ADDRESS);
    mid_soc_cmd_send(CMD_UPDATE_UPDATE_PARAMETER, CMD_RESULT_CODE_SUCCESS, data, data_len);
}

static bool erase_code_ready = false;
__attribute__((weak)) SOC_CMD_UPDATE_STATUS hal_erase_fw_update_partition(void) {return UPDATE_SUCCESS;}
void app_soc_cmd_update_erase_code_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    SOC_CMD_UPDATE_STATUS status = UPDATE_SUCCESS;
    if(!erase_code_ready) {
        status = hal_erase_fw_update_partition();
    }
    if(status == UPDATE_FAIL) {
        mid_soc_cmd_send(CMD_UPDATE_ERASE_CODE, CMD_RESULT_CODE_FAILURE, NULL, 0);
    }
    else {
        erase_code_ready = true;
        mid_soc_cmd_send(CMD_UPDATE_ERASE_CODE, CMD_RESULT_CODE_SUCCESS, NULL, 0);
    }
}

__attribute__((weak)) SOC_CMD_UPDATE_STATUS hal_write_fw_update_data(uint32_t start_addr, uint8_t *data, uint32_t len) {return UPDATE_SUCCESS;}
void app_soc_cmd_update_write_code_func(uint8_t *data, uint16_t len)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    if(len < 8) {
        mid_soc_cmd_send(CMD_UPDATE_WRITE_CODE, CMD_RESULT_CODE_FAILURE, NULL, 0);
        return;
    }

    SOC_CMD_UPDATE_STATUS status;
    uint32_t start_addr = 0;
    uint32_t write_len = 0;
    memcpy(&start_addr, &data[0], sizeof(start_addr));
    memcpy(&write_len, &data[4], sizeof(write_len));
    status = hal_write_fw_update_data(start_addr, &data[8], write_len);

    if(status == UPDATE_FAIL) {
        mid_soc_cmd_send(CMD_UPDATE_WRITE_CODE, CMD_RESULT_CODE_FAILURE, NULL, 0);
    }
    else {
        mid_soc_cmd_send(CMD_UPDATE_WRITE_CODE, CMD_RESULT_CODE_SUCCESS, NULL, 0);
    }
}

void app_soc_cmd_update_start_update_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    if(app_soc_cmd_update_get_operation_mode() != UPDATE_MODE)
    {
        app_soc_cmd_update_set_operation_mode(UPDATE_MODE);
    }
    mid_soc_cmd_send(CMD_UPDATE_START_UPDATE, CMD_RESULT_CODE_SUCCESS, NULL, 0);
}

__attribute__((weak)) void hal_end_fw_update(void) {}
void app_soc_cmd_update_end_update_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    mid_soc_cmd_send(CMD_UPDATE_END_UPDATE, CMD_RESULT_CODE_SUCCESS, NULL, 0);
    hal_end_fw_update();
}

void app_soc_cmd_update_operation_mode_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);
    uint16_t data_len = 1;
    uint8_t data[1];
    data[0] = app_soc_cmd_update_get_operation_mode();
    mid_soc_cmd_send(CMD_UPDATE_OPERATION_MODE, CMD_RESULT_CODE_SUCCESS, data, data_len);
}

__attribute__((weak)) SOC_CMD_UPDATE_STATUS hal_get_fw_update_program_state(void) {return UPDATE_SUCCESS;}
#define AP_NO_UPDATED   ((uint8_t)0x00)
#define AP_UPDATED      ((uint8_t)0x01)
void app_soc_cmd_update_program_state_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    SOC_CMD_UPDATE_STATUS status;
    uint16_t data_len = 1;
    uint8_t data[1];
    status = hal_get_fw_update_program_state();

    if(status == UPDATE_FAIL) {
        data[0] = AP_NO_UPDATED;
    }
    else {
        data[0] = AP_UPDATED;
    }
    mid_soc_cmd_send(CMD_UPDATE_PROGRAM_STATE, CMD_RESULT_CODE_SUCCESS, data, data_len);
}
</file>

<file path="app/src/app_soc_cmd_watchdog_func.c">
#include <stddef.h>
#include <stdio.h>
#include "app_soc_cmd_watchdog_func.h"
#include "app_soc_cmd.h"
#include "mid_log.h"

extern volatile uint64_t time_1ms;

bool soc_watchdog_en = false;
uint64_t soc_watchdog_start_time = 0;
uint32_t soc_watchdog_timeout = 0;

bool app_soc_cmd_watchdog_check(void)
{
    if(soc_watchdog_en) {
        if(time_1ms - soc_watchdog_start_time > soc_watchdog_timeout) {
            mid_log_print(LOG_VERBOSE, "soc watchdog timeout\r\n");
            return true;
        }
    } 
    return false;
}

bool app_soc_cmd_watchdog_get(void)
{
    return soc_watchdog_en;
}

void app_soc_cmd_watchdog_set(uint8_t status)
{
    if(status) {
        soc_watchdog_en = true;
    }
    else {
        soc_watchdog_en = false;
    }
}

void app_soc_cmd_watchdog_func(uint8_t status, uint32_t timeout_ms, uint16_t len)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    if(len != 5) {
        mid_soc_cmd_send(CMD_WATCHDOG, CMD_RESULT_CODE_INVALID_PARAMETERS, NULL, 0);
        return;
    }
    if(status) {
        soc_watchdog_start_time = time_1ms;
        soc_watchdog_timeout = timeout_ms;
    }
    app_soc_cmd_watchdog_set(status);
    mid_soc_cmd_send(CMD_WATCHDOG, CMD_RESULT_CODE_SUCCESS, NULL, 0);
}
void app_soc_cmd_watchdog_refresh_func(void)
{
    mid_log_print(LOG_VERBOSE, "%s\r\n", __FUNCTION__);

    soc_watchdog_start_time = time_1ms;
    mid_soc_cmd_send(CMD_WATCHDOG_REFRESH, CMD_RESULT_CODE_SUCCESS, NULL, 0);
}
</file>

<file path="app/src/app_soc_cmd.c">
#include "app_soc_cmd_control_func.h"
#include "app_soc_cmd_event_func.h"
#include "app_soc_cmd_info_func.h"
#include "app_soc_cmd_transceiver_func.h"
#include "app_soc_cmd_update_func.h"
#include "app_soc_cmd_watchdog_func.h"
#include "app_soc_cmd.h"

void app_soc_cmd_handler(const SOC_CMD *p_soc_cmd)
{
    switch((SOC_CMD_ID)p_soc_cmd->cmd) {
    case CMD_CONTROL_TONE:
        app_soc_cmd_control_tone_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_FAN:
        app_soc_cmd_control_fan_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_POWER:
        app_soc_cmd_control_power_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_buffer[1], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_ERP:
        app_soc_cmd_control_erp_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_DEBUG:
        app_soc_cmd_control_debug_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_buffer[1], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_REBOOT:
        app_soc_cmd_control_reboot_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_buffer[1], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_MCU_WATCHDOG:
        app_soc_cmd_control_mcu_watchdog_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_RS485:
        break;
    case CMD_CONTROL_QI:
        app_soc_cmd_control_QI_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_SYSTEM_PARAMETER:
        break;
    case CMD_CONTROL_POWER_MONITOR:
        break;
    case CMD_CONTROL_KEY:
        break;
    case CMD_CONTROL_LED_BEHAVIOR:
        app_soc_cmd_control_led_behavior_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_CONTROL_UART_SWITCH:
        break;
    case CMD_CONTROL_REFRESH_TOUCHPAD_FRAME:
        break;
    case CMD_CONTROL_UPDATE_SPECIFIED_PICTURE:
        break;
    case CMD_CONTROL_LED_COLOR: {
        uint8_t *data_ptr = (uint8_t *)p_soc_cmd->cmd_data_buffer;
        app_soc_cmd_control_led_color_func(data_ptr, p_soc_cmd->cmd_data_len);
        break;
    }
    case CMD_CONTROL_LED_LIGHT_STATUS:
        break;
    case CMD_CONTROL_HAPTIC_MOTOR_CONTROL:
        break;
    case CMD_CONTROL_DATA_DISPLAY:
        break;
    case CMD_CONTROL_SET_RTC:
        break;

    case CMD_WATCHDOG: {
        uint32_t timeout_ms = 0;
        timeout_ms =  p_soc_cmd->cmd_data_buffer[1];
        timeout_ms |= p_soc_cmd->cmd_data_buffer[2] << 8;
        timeout_ms |= p_soc_cmd->cmd_data_buffer[3] << 16;
        timeout_ms |= p_soc_cmd->cmd_data_buffer[4] << 24;
        app_soc_cmd_watchdog_func(p_soc_cmd->cmd_data_buffer[0], timeout_ms, p_soc_cmd->cmd_data_len);
        break;
    }
    case CMD_WATCHDOG_REFRESH:
        app_soc_cmd_watchdog_refresh_func();
        break;

    case CMD_EVENT_KEY:
        break;
    case CMD_EVENT_SAFETY_KEY:
        break;
    case CMD_EVENT_DEBUG_MESSAGE:
        break;
    case CMD_EVENT_LCB_STATUS:
        break;
    case CMD_EVENT_POWER_MONITOR:
        break;
    case CMD_EVENT_QI_STATUS:
        break;
    case CMD_EVENT_HEART_RATE_BPM:
        break;
    case CMD_EVENT_TOUCHPAD_TOUCH:
        break;

    case CMD_INFO_VERSION:
        app_soc_cmd_info_version_func();
        break;
    case CMD_INFO_SAFETY_KEY:
        /*Implemented in app_soc_cmd_event_func.c due to highly similar function logic.*/
        app_soc_cmd_info_safety_key_func();
        break;
    case CMD_INFO_POWER_STATE:
        app_soc_cmd_info_power_state_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_INFO_BOOT:
        app_soc_cmd_info_boot_func();
        break;
    case CMD_INFO_LCB_TYPE:
        break;
    case CMD_INFO_RECOVERY_STATE:
        app_soc_cmd_info_recovery_state_func();
        break;
    case CMD_INFO_FAN_SPEED:
        app_soc_cmd_info_fan_speed_func();
        break;
    case CMD_INFO_SYSTEM_STATE:
        break;
    case CMD_INFO_POWER_MONITOR_STATE:
        break;
    case CMD_INFO_KEY_STATE:
        break;
    case CMD_INFO_POWER_MONITOR:
        app_soc_cmd_info_power_monitor_func(p_soc_cmd->cmd_data_buffer[0], p_soc_cmd->cmd_data_len);
        break;
    case CMD_INFO_RTC_INFORMATION:
        break;

    case CMD_UPDATE_UPDATE_PARAMETER:
        app_soc_cmd_update_parameter_func();
        break;
    case CMD_UPDATE_ERASE_CODE:
        app_soc_cmd_update_erase_code_func();
        break;
    case CMD_UPDATE_WRITE_CODE: {
        uint8_t *data_ptr = (uint8_t *)p_soc_cmd->cmd_data_buffer;
        app_soc_cmd_update_write_code_func(data_ptr, p_soc_cmd->cmd_data_len);
        break;
    }
    case CMD_UPDATE_READ_CODE:
        break;
    case CMD_UPDATE_START_UPDATE:
        app_soc_cmd_update_start_update_func();
        break;
    case CMD_UPDATE_END_UPDATE:
        app_soc_cmd_update_end_update_func();
        break;
    case CMD_UPDATE_OPERATION_MODE:
        app_soc_cmd_update_operation_mode_func();
        break;
    case CMD_UPDATE_APPLICATION_NAME:
        break;
    case CMD_UPDATE_PROGRAM_STATE:
        app_soc_cmd_update_program_state_func();
        break;

    case CMD_TRAMSCEIVER_RFID_DATA:
        break;
    case CMD_TRAMSCEIVER_RFID_COMMAND:
        break;
    case CMD_TRAMSCEIVER_SET_CEC_CONFIG:
        break;
    case CMD_TRAMSCEIVER_SET_CEC_COMMAND:
        break;
    case CMD_TRAMSCEIVER_SET_CEC_RESPONSE:
        break;
    case CMD_TRAMSCEIVER_SEND_IR_COMMAND:
        break;
    case CMD_TRAMSCEIVER_SEND_BUMP_SENSOR_COMMAND: {
        uint8_t *data_ptr = (uint8_t *)p_soc_cmd->cmd_data_buffer;
        app_soc_cmd_transceiver_bump_sensor(data_ptr, p_soc_cmd->cmd_data_len);
        break;
    }
    case CMD_TRAMSCEIVER_SEND_CAB_COMMAND: {
        uint8_t *data_ptr = (uint8_t *)p_soc_cmd->cmd_data_buffer;
        app_soc_cmd_transceiver_csafe_cab(data_ptr, p_soc_cmd->cmd_data_len);
        break;
    }
    default:
        break;
    }
}
</file>

